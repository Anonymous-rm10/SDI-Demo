# All services load .env from the project directory. Existing environment wins.
MOCK_MODE=false
HOST=127.0.0.1
GATEWAY_PORT=8090
ASR_PORT=8091
TTS_PORT=8092
ASR_URL=http://127.0.0.1:8091
TTS_URL=http://127.0.0.1:8092
ASR_REPO=third_party/Qwen3-ASR
ASR_MODEL=models/Qwen3-ASR-0.6B
ASR_DEVICE=cuda:0
ASR_DTYPE=bfloat16
# Leave blank for automatic language detection.
ASR_LANGUAGE=
ASR_MAX_NEW_TOKENS=256
TTS_REPO=third_party/CosyVoice
TTS_MODEL=models/Fun-CosyVoice3-0.5B
TTS_PROMPT_WAV=third_party/CosyVoice/asset/zero_shot_prompt.wav
# Leave blank to use the transcript paired with the bundled reference WAV.
TTS_PROMPT_TEXT=
TTS_FP16=false
TTS_SPEED=1.0
# OpenAI-compatible Chat Completions; base URL includes /v1 where required.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT=60
LLM_MAX_TOKENS=512
SYSTEM_PROMPT="You are a friendly voice assistant. Reply concisely in the same language as the user using natural speech and no Markdown."
JEV_ENABLED=true
JEV_REPO=third_party/train-jev
JEV_BASE=models/Qwen3.5-4B
JEV_ADAPTER=models/train-jev-4b-lora
JEV_HOST=127.0.0.1
JEV_PORT=8020
JEV_URL=http://127.0.0.1:8020
JEV_TIMEOUT=3
JEV_THRESHOLD=0.65
# On JEV error: allow a new idle turn, keep current speech during playback.
# Energy VAD: normalized PCM RMS, tune for your microphone.
VAD_THRESHOLD=0.015
VAD_MIN_SPEECH_MS=240
VAD_SILENCE_MS=650
VAD_PREROLL_MS=200
VAD_MAX_UTTERANCE_MS=15000
MAX_HISTORY_TURNS=10
MAX_SESSIONS=4
