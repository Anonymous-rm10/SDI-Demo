{
  "model_dir": "../../models/FireRedASR2-LLM",
  "train_manifest": "../../datasets/kespeech/train_phase1.jsonl",
  "valid_manifest": "../../datasets/kespeech/train1_out/test.jsonl",
  "output_dir": "exp/FireRedASR2-LLM-SFT",
  "audio_root": "",
  "min_audio_seconds": 0.2,
  "max_audio_seconds": 40.0,
  "max_text_tokens": 192,
  "max_batch_frames": 6000,
  "max_batch_size": 8,
  "bucket_size": 128,
  "num_workers": 4,
  "instruction": "请转写音频为文字",
  "use_lora": true,
  "lora_rank": 64,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "up_proj",
    "gate_proj",
    "down_proj"
  ],
  "full_finetune_llm": false,
  "freeze_encoder": true,
  "train_encoder_last_n": 0,
  "train_adapter": true,
  "epochs": 1,
  "gradient_accumulation_steps": 1,
  "mixed_precision": "bf16",
  "use_flash_attention": false,
  "gradient_checkpointing": true,
  "adapter_learning_rate": 0.0001,
  "lora_learning_rate": 2e-05,
  "encoder_learning_rate": 2e-06,
  "weight_decay": 0.01,
  "warmup_ratio": 0.05,
  "max_grad_norm": 1.0,
  "log_steps": 2,
  "eval_steps": 1000,
  "save_steps": 1000,
  "keep_last_checkpoints": 3,
  "eval_generate": true,
  "eval_max_new_tokens": 160,
  "eval_num_beams": 1,
  "eval_repetition_penalty": 1.0,
  "wandb_enabled": true,
  "wandb_project": "fireredasr2-llm-sft",
  "wandb_entity": "",
  "wandb_run_name": "fireredasr2-domain-sft",
  "wandb_group": "",
  "wandb_tags": [
    "fireredasr2",
    "llm",
    "sft"
  ],
  "wandb_mode": "online",
  "wandb_run_id": "",
  "wandb_watch": "none",
  "wandb_watch_freq": 100
}
